# Contact form — copy to .env.local for local dev, and set the same keys in your
# Vercel project (Settings → Environment Variables) for production.

# Resend (https://resend.com) — API key from the dashboard.
RESEND_API_KEY=

# Verified sender on your Resend-verified domain, e.g. contact@olivierluethy.com
CONTACT_FROM_EMAIL=

# Where contact-form messages are delivered (your real inbox).
CONTACT_TO_EMAIL=

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile).
# Public site key — exposed to the browser (must start with NEXT_PUBLIC_).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key — server only, never expose.
TURNSTILE_SECRET_KEY=

# --- Local development ---------------------------------------------------------
# Cloudflare provides always-passing test keys so you can run the form without a
# real widget. Use these in .env.local only:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
